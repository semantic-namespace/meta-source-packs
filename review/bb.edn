;; meta-source's findings on sdiff's review page. EXPERIMENTAL.
{:paths ["src"]
 :deps {io.github.semantic-namespace/meta-source {:git/url "https://github.com/semantic-namespace/meta-source" :git/sha "9c3f10553fcc63ada2062a4f0aeb645eadcc928a"}
        ;; the packs a reviewed repository's meta-source.edn may enable
        io.github.semantic-namespace/meta-source-packs {:local/root ".."}
        io.github.semantic-namespace/diff {:git/url "https://github.com/semantic-namespace/diff"
                                           :git/sha "dea178353b9c8cc7e97d09c613b1a6d40e596940"}}
 :tasks {review {:doc "text <repo> <base> <head> | pr <owner/repo#N> | serve [port] [--host addr]"
                 :requires ([meta-source.review.main])
                 :task (apply meta-source.review.main/-main *command-line-args*)}
         test {:doc "the delta, a local range end to end, and the dependency bridge"
               :extra-paths ["test"]
               :requires ([clojure.test :as t] [meta-source.review-test] [meta-source.review.bridge-test])
               :task (let [{:keys [fail error]} (t/run-tests 'meta-source.review-test 'meta-source.review.bridge-test)]
                       (when (pos? (+ fail error)) (System/exit 1)))}}}
